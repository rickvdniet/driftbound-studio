# Copy to .env (never commit .env). All values optional.
# Where projects, media and the SQLite database live (relocatable):
# DRIFTBOUND_WORKSPACE=/path/to/workspace
DRIFTBOUND_HOST=127.0.0.1
DRIFTBOUND_PORT=8000
# Free YouTube Data API v3 key for competitor research (Google Cloud console → Credentials → API key):
DRIFTBOUND_YOUTUBE_API_KEY=
# Local services
DRIFTBOUND_OLLAMA_URL=http://127.0.0.1:11434
DRIFTBOUND_COMFYUI_URL=http://127.0.0.1:8188
# OAuth client for uploads (downloaded JSON) and where the token is stored:
DRIFTBOUND_YOUTUBE_CLIENT_SECRETS=secrets/client_secret.json
DRIFTBOUND_YOUTUBE_TOKEN_FILE=secrets/youtube_token.json
# Custom ffmpeg/ffprobe paths if not on PATH:
# DRIFTBOUND_FFMPEG=ffmpeg
# DRIFTBOUND_FFPROBE=ffprobe
